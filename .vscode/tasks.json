{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++.exe 生成活动文件",
            "command": "C:\\Users\\HH\\scoop\\apps\\llvm\\current\\bin\\clang++.exe",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\bsp.cpp",
                "-I", "${workspaceFolder}\\libs\\zlgcan_x86",
                "${workspaceFolder}\\libs\\zlgcan_x86\\zlgcan.lib",
                "-o", "${workspaceFolder}\\src\\main.exe"
